# Address where Portfolio Viewer is reachable, without a trailing slash.
PUBLIC_URL=http://localhost:3000

# Database password, letters and digits only. Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Secret that signs login sessions, at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Price source. "yahoo" uses Yahoo Finance and the ECB, free for private use; you are responsible
# for complying with their terms. "demo" offers four fixed demo securities with made-up prices and
# needs no internet access (for trying the app out).
MARKET_DATA_PROVIDER=yahoo

# Optional: the release to run, e.g. 0.1.0 (default: the latest release). Pin it to update on your own
# schedule: change the number, then `docker compose pull && docker compose up -d`.
# PORTFOLIO_VIEWER_VERSION=0.1.0

# Optional: host port (default 3000).
# PORT=3000

# Optional: every page links to the source code, as the AGPL-3.0 asks. If you run a modified copy,
# set this to the address where your users can get your source code.
# SOURCE_URL=https://github.com/JBP-Capital/portfolio-viewer

# Optional: e-mail delivery for password resets. When configured, also set EMAIL_AUTOCONFIRM=false
# so new accounts must confirm their address.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# EMAIL_AUTOCONFIRM=false
